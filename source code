bool IsWhitelisted(const fs::path& file) {
    std::wstring name = file.filename().wstring();
    for (auto& c : name) c = towlower(c);
    for (auto& wl : g_whitelist_names) if (name == wl) return true;
    return false;
}

bool HasSuspiciousAPIs(const std::wstring& filepath) {
    std::ifstream file(filepath, std::ios::binary);
    if (!file) return false;
    file.seekg(0, std::ios::end);
    std::streamsize size = file.tellg();
    file.seekg(0, std::ios::beg);
    if (size > 100 * 1024 * 1024) return false;
    const size_t CHUNK = 65536;
    std::vector<char> buffer(CHUNK);
    std::string overlap;
    while (file.read(buffer.data(), CHUNK) || file.gcount() > 0) {
        size_t bytesRead = file.gcount();
        std::string chunk(buffer.data(), bytesRead);
        chunk = overlap + chunk;
        for (auto& api : g_dangerous_apis) if (chunk.find(api) != std::string::npos) return true;
        size_t os = 32;
        if (chunk.size() > os) overlap = chunk.substr(chunk.size() - os);
        else overlap = chunk;
    }
    return false;
}

// === Поток сканирования ===
void ScanThreadFunc(HWND hWnd, std::wstring folder) {
    if (!fs::exists(folder) || !fs::is_directory(folder)) {
        std::wstring* done = new std::wstring(L(L"Folder does not exist: ", L"Папка не существует: ") + folder);
        PostMessage(hWnd, WM_SCAN_DONE, 0, (LPARAM)done);
        g_scanning.store(false);
        return;
    }

    int total = 0, found = 0;
    try {
        for (auto& entry : fs::recursive_directory_iterator(folder)) {
            if (fs::is_regular_file(entry.path())) {
                total++;
                std::wstring name = entry.path().filename().wstring();
                std::wstring ext = entry.path().extension().wstring();
                for (auto& c : name) c = towlower(c);
                for (auto& c : ext) c = towlower(c);
                bool suspicious = false;
                std::wstring reason;

                if (!IsWhitelisted(entry.path())) {
                    for (auto& e : g_dangerous_ext) if (ext == e) { suspicious = true; reason = L(L"Dangerous extension", L"Опасное расширение"); break; }
                    if (!suspicious) for (auto& w : g_dangerous_words) if (name.find(w) != std::wstring::npos) { suspicious = true; reason = L(L"Dangerous name", L"Опасное имя"); break; }
                    if (!suspicious) {
                        std::wstring sha = GetSHA256(entry.path().wstring());
                        if (!sha.empty() && CheckHashInDB(sha)) { suspicious = true; reason = L(L"VIRUS (SHA-256)", L"ВИРУС (SHA-256)"); }
                        if (!suspicious) {
                            std::wstring md5 = GetMD5(entry.path().wstring());
                            if (!md5.empty() && CheckHashInDB(md5)) { suspicious = true; reason = L(L"VIRUS (MD5)", L"ВИРУС (MD5)"); }
                        }
                    }
                    if (!suspicious && (ext == L".exe" || ext == L".dll" || ext == L".sys" || ext == L".ocx" || ext == L".cpl" || ext == L".drv")) {
                        if (!IsDigitallySigned(entry.path().wstring()) && HasSuspiciousAPIs(entry.path().wstring())) {
                            suspicious = true; reason = L(L"Suspicious APIs", L"Подозрительные API");
                        }
                        if (!suspicious && HasPackedSections(entry.path().wstring())) {
                            suspicious = true; reason = L(L"Packed PE", L"Упакованный PE");
                        }
                    }
                    if (!suspicious && (ext == L".exe" || ext == L".dll" || ext == L".sys")) {
                        double ent = GetEntropy(entry.path().wstring());
                        if (ent > 7.5) { suspicious = true; reason = L(L"High entropy (", L"Высокая энтропия (") + std::to_wstring(ent).substr(0, 4) + L")"; }
                    }
                    if (!suspicious && (ext == L".zip" || ext == L".rar" || ext == L".7z")) {
                        double ent = GetEntropy(entry.path().wstring());
                        if (ent > 7.5) {
                            suspicious = true;
                            reason = L(L"Suspicious archive (check manually)", L"Подозрительный архив (проверьте вручную)");
                        }
                    }
                }

                if (suspicious) {
                    found++;
                    ScanResult* r = new ScanResult{ entry.path().wstring(), reason };
                    PostMessage(hWnd, WM_SCAN_PROGRESS, 0, (LPARAM)r);
                }
            }
        }
    }
    catch (...) {}
    std::wstring* done = new std::wstring(
        L(L"Scanned: ", L"Проверено: ") + std::to_wstring(total) +
        L(L", found: ", L", найдено: ") + std::to_wstring(found));
    PostMessage(hWnd, WM_SCAN_DONE, (WPARAM)found, (LPARAM)done);
}

void StartScanAsync(HWND hWnd, const std::wstring& folder) {
    if (g_scanning.load()) { LogMessage(L(L"Scan already in progress...", L"Сканирование уже идёт...")); return; }
    g_scanning.store(true);
    LogMessage(L(L"Scanning: ", L"Сканирование: ") + folder);
    SetStatus(L(L"Scanning...", L"Сканирование..."));
    std::thread(ScanThreadFunc, hWnd, folder).detach();
}

// === ReadDirectoryChangesW — мониторинг папок ===
void FsMonitorThreadFunc(HWND hWnd, std::wstring folder) {
    HANDLE hDir = CreateFileW(folder.c_str(), FILE_LIST_DIRECTORY,
        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
        NULL, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NULL);
    if (hDir == INVALID_HANDLE_VALUE) return;

    BYTE buffer[4096];
    DWORD bytesReturned = 0;

    while (g_fsMonitor.load()) {
        if (ReadDirectoryChangesW(hDir, buffer, sizeof(buffer), TRUE,
            FILE_NOTIFY_CHANGE_FILE_NAME | FILE_NOTIFY_CHANGE_LAST_WRITE,
            &bytesReturned, NULL, NULL)) {

            FILE_NOTIFY_INFORMATION* fni = (FILE_NOTIFY_INFORMATION*)buffer;
            do {
                std::wstring filename(fni->FileName, fni->FileNameLength / sizeof(WCHAR));
                std::wstring fullPath = folder + L"\\" + filename;

                if (fni->Action == FILE_ACTION_ADDED || fni->Action == FILE_ACTION_MODIFIED) {
                    if (fs::exists(fullPath)) {
                        std::wstring ext = fs::path(fullPath).extension().wstring();
                        for (auto& c : ext) c = towlower(c);
                        bool susp = false;
                        for (auto& e : g_dangerous_ext) if (ext == e) { susp = true; break; }
                        if (susp) {
                            std::wstring* alert = new std::wstring(L(L"FILE: ", L"ФАЙЛ: ") + fullPath + L" (" + ext + L")");
                            PostMessage(hWnd, WM_FS_ALERT, 0, (LPARAM)alert);
                        }
                    }
                }
                if (fni->NextEntryOffset == 0) break;
                fni = (FILE_NOTIFY_INFORMATION*)((BYTE*)fni + fni->NextEntryOffset);
            } while (true);
        }
    }
    CloseHandle(hDir);
}

void StartFsMonitor(HWND hWnd) {
    if (g_fsMonitor.load()) {
        g_fsMonitor.store(false);
        LogMessage(L(L"Folder monitoring stopped", L"Мониторинг папок остановлен"));
    }
    else {
        g_fsMonitor.store(true);
        LogMessage(L(L"Folder monitoring started", L"Мониторинг папок запущен"));
        wchar_t userBuf[256] = { 0 };
        GetEnvironmentVariableW(L"USERNAME", userBuf, 256);
        std::wstring user = userBuf;
        if (user.empty()) {
            LogMessage(L(L"Failed to get username", L"Не удалось получить имя пользователя"));
            g_fsMonitor.store(false);
            return;
        }
        std::thread(FsMonitorThreadFunc, hWnd, L"C:\\Users\\" + user + L"\\Downloads").detach();
        std::thread(FsMonitorThreadFunc, hWnd, L"C:\\Users\\" + user + L"\\Desktop").detach();
        std::thread(FsMonitorThreadFunc, hWnd, L"C:\\Users\\" + user + L"\\Documents").detach();
    }
}

// === Мониторинг реестра ===
void RegMonitorThreadFunc(HWND hWnd) {
    while (g_regMonitor.load()) {
        HKEY hKey;
        const wchar_t* paths[] = {
            L"Software\\Microsoft\\Windows\\CurrentVersion\\Run",
            L"Software\\Microsoft\\Windows\\CurrentVersion\\RunOnce"
        };
        for (auto path : paths) {
            if (RegOpenKeyExW(HKEY_CURRENT_USER, path, 0, KEY_READ, &hKey) == ERROR_SUCCESS) {
                wchar_t name[256], value[1024];
                DWORD nameSize, valueSize, type;
                DWORD idx = 0;
                while (true) {
                    nameSize = 256; valueSize = 1024;
                    if (RegEnumValueW(hKey, idx, name, &nameSize, NULL, &type, (BYTE*)value, &valueSize) != ERROR_SUCCESS) break;
                    std::wstring wname = name;
                    std::wstring wvalue = value;
                    std::wstring lower = wname;
                    for (auto& c : lower) c = towlower(c);
                    for (auto& dw : g_dangerous_words) {
                        if (lower.find(dw) != std::wstring::npos) {
                            std::wstring* alert = new std::wstring(L(L"REGISTRY: ", L"РЕЕСТР: ") + wname + L" -> " + wvalue);
                            PostMessage(hWnd, WM_MONITOR_ALERT, 0, (LPARAM)alert);
                        }
                    }
                    idx++;
                }
                RegCloseKey(hKey);
            }
        }
        for (int i = 0; i < 50 && g_regMonitor.load(); i++) Sleep(100);
    }
}

void StartRegMonitor(HWND hWnd) {
    if (g_regMonitor.load()) { g_regMonitor.store(false); LogMessage(L(L"Registry monitoring stopped", L"Мониторинг реестра остановлен")); }
    else { g_regMonitor.store(true); LogMessage(L(L"Registry monitoring started", L"Мониторинг реестра запущен")); std::thread(RegMonitorThreadFunc, hWnd).detach(); }
}

// === Мониторинг планировщика ===
void TaskMonitorThreadFunc(HWND hWnd) {
    while (g_taskMonitor.load()) {
        std::wstring tasksPath = L"C:\\Windows\\System32\\Tasks";
        try {
            for (auto& entry : fs::recursive_directory_iterator(tasksPath)) {
                if (fs::is_regular_file(entry.path())) {
