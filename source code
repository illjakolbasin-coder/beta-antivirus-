// === SQLite ===
void InitDB() {
    if (sqlite3_open("signatures.db", &g_db) != SQLITE_OK) { LogMessage(L(L"Failed to open database", L"Ошибка открытия базы")); return; }
    const char* sql_sig = "CREATE TABLE IF NOT EXISTS signatures (id INTEGER PRIMARY KEY AUTOINCREMENT, hash TEXT UNIQUE, name TEXT);";
    const char* sql_hist = "CREATE TABLE IF NOT EXISTS history (id INTEGER PRIMARY KEY AUTOINCREMENT, folder TEXT, date TEXT, total INTEGER, found INTEGER);";
    const char* sql_quar = "CREATE TABLE IF NOT EXISTS quarantine (id INTEGER PRIMARY KEY AUTOINCREMENT, original_path TEXT, quarantine_path TEXT, date_added TEXT);";
    char* errMsg = nullptr;
    sqlite3_exec(g_db, sql_sig, nullptr, nullptr, &errMsg);
    sqlite3_exec(g_db, sql_hist, nullptr, nullptr, &errMsg);
    sqlite3_exec(g_db, sql_quar, nullptr, nullptr, &errMsg);
}

bool CheckHashInDB(const std::wstring& hash) {
    if (!g_db) return false;
    std::string narrow; for (wchar_t c : hash) narrow += static_cast<char>(c);
    sqlite3_stmt* stmt;
    const char* sql = "SELECT name FROM signatures WHERE hash = ?;";
    bool found = false;
    if (sqlite3_prepare_v2(g_db, sql, -1, &stmt, nullptr) == SQLITE_OK) {
        sqlite3_bind_text(stmt, 1, narrow.c_str(), -1, SQLITE_STATIC);
        if (sqlite3_step(stmt) == SQLITE_ROW) found = true;
        sqlite3_finalize(stmt);
    }
    return found;
}

void SaveScanHistory(const std::wstring& folder, int total, int found) {
    if (!g_db) return;
    std::string f; for (wchar_t c : folder) f += static_cast<char>(c);
    time_t now = time(0);
    char d[64];
    strftime(d, sizeof(d), "%Y-%m-%d %H:%M:%S", localtime(&now));
    sqlite3_stmt* stmt;
    const char* sql = "INSERT INTO history (folder, date, total, found) VALUES (?, ?, ?, ?);";
    if (sqlite3_prepare_v2(g_db, sql, -1, &stmt, nullptr) == SQLITE_OK) {
        sqlite3_bind_text(stmt, 1, f.c_str(), -1, SQLITE_STATIC);
        sqlite3_bind_text(stmt, 2, d, -1, SQLITE_STATIC);
        sqlite3_bind_int(stmt, 3, total);
        sqlite3_bind_int(stmt, 4, found);
        sqlite3_step(stmt);
        sqlite3_finalize(stmt);
    }
}

void SaveQuarantine(const std::wstring& o, const std::wstring& q) {
    if (!g_db) return;
    std::string os, qs;
    for (wchar_t c : o) os += static_cast<char>(c);
    for (wchar_t c : q) qs += static_cast<char>(c);
    time_t now = time(0);
    char d[64];
    strftime(d, sizeof(d), "%Y-%m-%d %H:%M:%S", localtime(&now));
    sqlite3_stmt* stmt;
    const char* sql = "INSERT INTO quarantine (original_path, quarantine_path, date_added) VALUES (?, ?, ?);";
    if (sqlite3_prepare_v2(g_db, sql, -1, &stmt, nullptr) == SQLITE_OK) {
        sqlite3_bind_text(stmt, 1, os.c_str(), -1, SQLITE_STATIC);
        sqlite3_bind_text(stmt, 2, qs.c_str(), -1, SQLITE_STATIC);
