// === Мониторинг процессов ===
void MonitorThreadFunc(HWND hWnd) {
    while (g_monitoring.load()) {
        HANDLE hSnap = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
        if (hSnap != INVALID_HANDLE_VALUE) {
            PROCESSENTRY32W pe = { sizeof(pe) };
            if (Process32FirstW(hSnap, &pe)) {
                do {
                    std::wstring name = pe.szExeFile;
                    std::wstring lower = ToLowerW(name);

                    bool trusted = false;
                    for (auto& tp : g_trusted_processes) if (lower == tp) { trusted = true; break; }
                    if (trusted) continue;

                    for (auto& w : g_dangerous_words) {
                        if (lower.find(w) != std::wstring::npos) {
                            std::wstring* alert = new std::wstring(L(L"Suspicious process: ", L"Подозрительный процесс: ") + name);
                            PostMessage(hWnd, WM_MONITOR_ALERT, 0, (LPARAM)alert);
                            break;
                        }
                    }
                } while (Process32NextW(hSnap, &pe));
            }
            CloseHandle(hSnap);
        }
        for (int i = 0; i < 30 && g_monitoring.load(); i++) Sleep(100);
    }
}

void StartMonitoring(HWND hWnd) {
    if (g_monitoring.load()) { g_monitoring.store(false); LogMessage(L(L"Process monitoring stopped", L"Мониторинг процессов остановлен")); }
    else { g_monitoring.store(true); LogMessage(L(L"Process monitoring started", L"Мониторинг процессов запущен")); std::thread(MonitorThreadFunc, hWnd).detach(); }
}

// === Anti-Ransomware ===
int CountEncryptedFiles(const std::wstring& folder) {
    int count = 0;
    try { for (auto& e : fs::recursive_directory_iterator(folder)) if (e.path().extension() == L".encrypted") count++; }
    catch (...) {}
    return count;
}

void AntiRansomThreadFunc(HWND hWnd) {
    wchar_t userBuf[256] = { 0 };
    GetEnvironmentVariableW(L"USERNAME", userBuf, 256);
    std::wstring folder = L"C:\\Users\\" + std::wstring(userBuf) + L"\\Documents";
    int lastCount = CountEncryptedFiles(folder);
    while (g_monitoring.load()) {
        for (int i = 0; i < 50 && g_monitoring.load(); i++) Sleep(100);
        int newCount = CountEncryptedFiles(folder);
        int diff = newCount - lastCount;
        if (diff > 50) {
            std::wstring* alert = new std::wstring(L(L"ENCRYPTION DETECTED: +", L"ОБНАРУЖЕНО ШИФРОВАНИЕ: +") + std::to_wstring(diff) + L(L" files", L" файлов"));
            PostMessage(hWnd, WM_MONITOR_ALERT, 0, (LPARAM)alert);
            HANDLE hSnap = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
            if (hSnap != INVALID_HANDLE_VALUE) {
                PROCESSENTRY32W pe = { sizeof(pe) };
                if (Process32FirstW(hSnap, &pe)) {
                    do {
                        std::wstring name = pe.szExeFile;
                        std::wstring lower = name;
                        for (auto& c : lower) c = towlower(c);
                        for (auto& w : g_dangerous_words) {
                            if (lower.find(w) != std::wstring::npos) {
                                HANDLE hProc = OpenProcess(PROCESS_TERMINATE, FALSE, pe.th32ProcessID);
                                if (hProc) { TerminateProcess(hProc, 0); CloseHandle(hProc); }
                            }
                        }
                    } while (Process32NextW(hSnap, &pe));
                }
                CloseHandle(hSnap);
            }
        }
        lastCount = newCount;
    }
}

// === Карантин ===
void MoveToQuarantine(const std::wstring& filepath) {
    fs::create_directory("quarantine");
    fs::path src(filepath);
    fs::path dst = fs::path("quarantine") / src.filename();
    try {
        if (fs::exists(dst)) dst = fs::path("quarantine") / (src.stem().wstring() + L"_" + std::to_wstring(GetTickCount()) + src.extension().wstring());
        fs::copy_file(src, dst, fs::copy_options::overwrite_existing);
        fs::remove(src);
        SaveQuarantine(filepath, dst.wstring());
        LogMessage(L(L"Quarantined: ", L"В карантин: ") + src.filename().wstring());
    }
    catch (const std::exception& e) {
        std::wstring err(e.what(), e.what() + strlen(e.what()));
        LogMessage(L(L"Failed: ", L"Не удалось: ") + src.filename().wstring() + L" (" + err + L")");
    }
}

void QuarantineAll() {
    int count = ListView_GetItemCount(hListView);
    for (int i = 0; i < count; i++) {
        wchar_t buf[1024];
        ListView_GetItemText(hListView, i, 0, buf, 1024);
        std::wstring t(buf);
        if (fs::exists(t) && fs::is_regular_file(t)) MoveToQuarantine(t);
    }
}

void RestoreFromQuarantine() {
    if (!g_db) return;
    sqlite3_stmt* stmt;
    const char* sql = "SELECT original_path, quarantine_path FROM quarantine ORDER BY id DESC;";
    if (sqlite3_prepare_v2(g_db, sql, -1, &stmt, nullptr) == SQLITE_OK) {
        while (sqlite3_step(stmt) == SQLITE_ROW) {
            std::string o((const char*)sqlite3_column_text(stmt, 0));
            std::string q((const char*)sqlite3_column_text(stmt, 1));
            std::wstring ow(o.begin(), o.end()), qw(q.begin(), q.end());
            if (fs::exists(qw)) {
                try {
                    fs::copy_file(qw, ow, fs::copy_options::overwrite_existing);
                    fs::remove(qw);
                    LogMessage(L(L"Restored: ", L"Восстановлен: ") + ow);
                }
                catch (...) {}
            }
        }
        sqlite3_finalize(stmt);
    }
    sqlite3_exec(g_db, "DELETE FROM quarantine;", nullptr, nullptr, nullptr);
}

std::wstring SelectFolder(HWND hwnd) {
    BROWSEINFOW bi = { 0 };
    bi.hwndOwner = hwnd; bi.lpszTitle = T(L"Select folder", L"Выберите папку");
    bi.ulFlags = BIF_RETURNONLYFSDIRS | BIF_NEWDIALOGSTYLE;
    LPITEMIDLIST pidl = SHBrowseForFolderW(&bi);
    if (pidl) { wchar_t path[MAX_PATH]; if (SHGetPathFromIDListW(pidl, path)) { CoTaskMemFree(pidl); return std::wstring(path); } CoTaskMemFree(pidl); }
    return L"";
}

