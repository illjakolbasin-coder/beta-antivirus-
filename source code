// === Мониторинг сети ===
void NetMonitorThreadFunc(HWND hWnd) {
    while (g_netMonitor.load()) {
        DWORD size = 0;
        GetExtendedTcpTable(NULL, &size, FALSE, AF_INET, TCP_TABLE_OWNER_PID_ALL, 0);
        std::vector<BYTE> buffer(size);
        DWORD result = GetExtendedTcpTable(buffer.data(), &size, FALSE, AF_INET, TCP_TABLE_OWNER_PID_ALL, 0);

        if (result == ERROR_INSUFFICIENT_BUFFER) {
            buffer.resize(size);
            result = GetExtendedTcpTable(buffer.data(), &size, FALSE, AF_INET, TCP_TABLE_OWNER_PID_ALL, 0);
        }

        if (result == NO_ERROR) {
            MIB_TCPTABLE_OWNER_PID* table = (MIB_TCPTABLE_OWNER_PID*)buffer.data();
            for (DWORD i = 0; i < table->dwNumEntries; i++) {
                auto& row = table->table[i];
                if (row.dwState == MIB_TCP_STATE_ESTAB) {
                    DWORD pid = row.dwOwningPid;
                    HANDLE hProc = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid);
                    if (hProc) {
                        wchar_t path[MAX_PATH];
                        DWORD pathSize = MAX_PATH;
                        if (QueryFullProcessImageNameW(hProc, 0, path, &pathSize)) {
                            std::wstring wpath = path;
                            std::wstring lower = fs::path(wpath).filename().wstring();
                            for (auto& c : lower) c = towlower(c);
                            for (auto& dw : g_dangerous_words) {
                                if (lower.find(dw) != std::wstring::npos) {
                                    std::wstring* alert = new std::wstring(L(L"NETWORK: ", L"СЕТЬ: ") + lower + L" -> " + std::to_wstring(row.dwRemoteAddr) + L":" + std::to_wstring(row.dwRemotePort));
                                    PostMessage(hWnd, WM_MONITOR_ALERT, 0, (LPARAM)alert);
                                }
                            }
                        }
                        CloseHandle(hProc);
                    }
                }
            }
        }
        for (int i = 0; i < 50 && g_netMonitor.load(); i++) Sleep(100);
    }
}

void StartNetMonitor(HWND hWnd) {
    if (g_netMonitor.load()) { g_netMonitor.store(false); LogMessage(L(L"Network monitoring stopped", L"Мониторинг сети остановлен")); }
    else { g_netMonitor.store(true); LogMessage(L(L"Network monitoring started", L"Мониторинг сети запущен")); std::thread(NetMonitorThreadFunc, hWnd).detach(); }
